# Copy to .env and fill in. Never commit .env.
APP_ENV=dev

# --- Database (Postgres 16 + pgvector, see docker-compose.yml) ---
POSTGRES_USER=invesit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invesit
DATABASE_URL=postgresql+psycopg://invesit:change-me@localhost:5432/invesit
# Separate, throwaway database for integration tests (tables are wiped). Leave empty to skip DB tests.
TEST_DATABASE_URL=

# --- LLM (provider not chosen yet; "fake" = offline, used by tests) ---
# One of: fake, anthropic, openai, mistral, google, ollama
LLM_PROVIDER=fake
LLM_MODEL=
LLM_MODEL_CHEAP=
LLM_API_KEY=

# --- Langfuse (tracing is disabled when keys are empty) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Self-hosted Langfuse server (docker-compose only) ---
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
LANGFUSE_SALT=change-me-generate-with-openssl-rand-base64-32
